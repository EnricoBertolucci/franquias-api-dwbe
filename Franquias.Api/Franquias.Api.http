@Franquias.Api_HostAddress = http://localhost:5192

### Health check
GET {{Franquias.Api_HostAddress}}/api/health
Accept: application/json

###
# 1) Login (troque pelo e-mail/senha de um usuário Administrador já existente no banco)
# @name login
POST {{Franquias.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@franquias.com",
  "senha": "Admin@123"
}

###
# 2) Criar franqueadora (usa o token retornado pelo login acima)
# @name criarFranqueadora
POST {{Franquias.Api_HostAddress}}/api/franqueadora
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "razaoSocial": "Rede Exemplo Ltda",
  "nomeFantasia": "Rede Exemplo",
  "cnpj": "11.222.333/0001-44",
  "email": "contato@rede.com",
  "telefone": "11999990000"
}

###
# 3) Listar franqueadoras
GET {{Franquias.Api_HostAddress}}/api/franqueadora
Authorization: Bearer {{login.response.body.token}}

###
# 4) Criar unidade franqueada (troque franqueadoraId pelo id retornado no passo 2)
# @name criarUnidade
POST {{Franquias.Api_HostAddress}}/api/unidades
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "franqueadoraId": 1,
  "nome": "Unidade Centro",
  "cnpj": "22.333.444/0001-55",
  "telefone": "1133334444",
  "logradouro": "Rua A, 100",
  "cidade": "Sao Paulo",
  "estado": "SP",
  "cep": "01000-000",
  "dataInicio": "2024-01-10",
  "percentualRoyalty": 5.5,
  "responsaveis": [
    {
      "nome": "Joao Silva",
      "cpf": "111.222.333-44",
      "email": "joao@teste.com",
      "telefone": "11988887777",
      "cargo": "Gerente",
      "responsavelPrincipal": true
    }
  ]
}

###
# 5) Listar unidades com filtro + paginação
GET {{Franquias.Api_HostAddress}}/api/unidades?cidade=Paulo&pagina=1&tamanhoPagina=10&ordenarPor=nome
Authorization: Bearer {{login.response.body.token}}

###
# 6) Obter unidade por id (troque pelo id retornado no passo 4)
GET {{Franquias.Api_HostAddress}}/api/unidades/1
Authorization: Bearer {{login.response.body.token}}

###
# 7) Inativar unidade
PATCH {{Franquias.Api_HostAddress}}/api/unidades/1/inativar
Authorization: Bearer {{login.response.body.token}}

###
# 8) Ativar unidade
PATCH {{Franquias.Api_HostAddress}}/api/unidades/1/ativar
Authorization: Bearer {{login.response.body.token}}

###
# 9) Criar categoria
# @name criarCategoria
POST {{Franquias.Api_HostAddress}}/api/categorias
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "nome": "Bebidas",
  "descricao": "Bebidas em geral"
}

###
# 10) Listar categorias
GET {{Franquias.Api_HostAddress}}/api/categorias?ativo=true
Authorization: Bearer {{login.response.body.token}}

###
# 11) Atualizar categoria (troque o id pelo retornado no passo 9)
PUT {{Franquias.Api_HostAddress}}/api/categorias/1
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "nome": "Bebidas",
  "descricao": "Bebidas quentes e frias",
  "ativo": true
}

###
# 12) Criar produto/servico (troque categoriaId pelo id retornado no passo 9)
# @name criarProduto
POST {{Franquias.Api_HostAddress}}/api/produtos
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "categoriaId": 1,
  "nome": "Refrigerante Lata 350ml",
  "descricao": "Refrigerante lata 350ml sabor cola",
  "tipo": 1,
  "precoBase": 6.5
}

###
# 13) Listar produtos com filtro + paginação
GET {{Franquias.Api_HostAddress}}/api/produtos?nome=Refrigerante&categoriaId=1&ativo=true&pagina=1&tamanhoPagina=10&ordenarPor=nome
Authorization: Bearer {{login.response.body.token}}

###
# 14) Obter produto por id (troque pelo id retornado no passo 12)
GET {{Franquias.Api_HostAddress}}/api/produtos/1
Authorization: Bearer {{login.response.body.token}}

###
# 15) Atualizar produto
PUT {{Franquias.Api_HostAddress}}/api/produtos/1
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "categoriaId": 1,
  "nome": "Refrigerante Lata 350ml",
  "descricao": "Refrigerante lata 350ml sabor cola",
  "tipo": 1,
  "precoBase": 7.0
}

###
# 16) Inativar produto
PATCH {{Franquias.Api_HostAddress}}/api/produtos/1/inativar
Authorization: Bearer {{login.response.body.token}}

###
# 17) Ativar produto
PATCH {{Franquias.Api_HostAddress}}/api/produtos/1/ativar
Authorization: Bearer {{login.response.body.token}}

###
# 18) Criar fornecedor
# @name criarFornecedor
POST {{Franquias.Api_HostAddress}}/api/fornecedores
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "razaoSocial": "Distribuidora Exemplo Ltda",
  "cnpj": "33.444.555/0001-66",
  "email": "contato@distribuidora.com",
  "telefone": "1133335555"
}

###
# 19) Listar fornecedores com filtro + paginação
GET {{Franquias.Api_HostAddress}}/api/fornecedores?nome=Distribuidora&pagina=1&tamanhoPagina=10&ordenarPor=razaosocial
Authorization: Bearer {{login.response.body.token}}

###
# 20) Obter fornecedor por id (troque pelo id retornado no passo 18)
GET {{Franquias.Api_HostAddress}}/api/fornecedores/1
Authorization: Bearer {{login.response.body.token}}

###
# 21) Atualizar fornecedor
PUT {{Franquias.Api_HostAddress}}/api/fornecedores/1
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "razaoSocial": "Distribuidora Exemplo Ltda",
  "cnpj": "33.444.555/0001-66",
  "email": "financeiro@distribuidora.com",
  "telefone": "1133336666"
}

###
# 22) Associar produto ao fornecedor (troque pelo id de fornecedor e de produto já existentes)
POST {{Franquias.Api_HostAddress}}/api/fornecedores/1/produtos/1
Authorization: Bearer {{login.response.body.token}}

###
# 23) Desassociar produto do fornecedor
DELETE {{Franquias.Api_HostAddress}}/api/fornecedores/1/produtos/1
Authorization: Bearer {{login.response.body.token}}

###
# 24) Inativar fornecedor
PATCH {{Franquias.Api_HostAddress}}/api/fornecedores/1/inativar
Authorization: Bearer {{login.response.body.token}}

###
# 25) Ativar fornecedor
PATCH {{Franquias.Api_HostAddress}}/api/fornecedores/1/ativar
Authorization: Bearer {{login.response.body.token}}

###
# 26) Registrar movimentacao de entrada de estoque (troque unidadeFranqueadaId/produtoServicoId pelos ids ja existentes)
# @name entradaEstoque
POST {{Franquias.Api_HostAddress}}/api/estoques/movimentacoes
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "unidadeFranqueadaId": 1,
  "produtoServicoId": 1,
  "tipo": 1,
  "quantidade": 50,
  "observacao": "Entrada inicial de estoque"
}

###
# 27) Definir estoque minimo do item (para habilitar a consulta de criticos)
PUT {{Franquias.Api_HostAddress}}/api/estoques/1/1/minimo
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "quantidadeMinima": 10
}

###
# 28) Listar saldo de estoque por unidade
GET {{Franquias.Api_HostAddress}}/api/estoques?unidadeId=1
Authorization: Bearer {{login.response.body.token}}

###
# 29) Obter saldo de um item especifico
GET {{Franquias.Api_HostAddress}}/api/estoques/1/1
Authorization: Bearer {{login.response.body.token}}

###
# 30) Registrar movimentacao de saida de estoque (deve funcionar, pois ha saldo suficiente)
POST {{Franquias.Api_HostAddress}}/api/estoques/movimentacoes
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "unidadeFranqueadaId": 1,
  "produtoServicoId": 1,
  "tipo": 2,
  "quantidade": 45,
  "observacao": "Venda balcao"
}

###
# 31) Registrar movimentacao de saida maior que o saldo disponivel (deve retornar 400)
POST {{Franquias.Api_HostAddress}}/api/estoques/movimentacoes
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "unidadeFranqueadaId": 1,
  "produtoServicoId": 1,
  "tipo": 2,
  "quantidade": 1000,
  "observacao": "Saida maior que o saldo (deve falhar)"
}

###
# 32) Listar itens abaixo do estoque minimo (deve retornar o item apos a saida do passo 30, saldo=5 < minimo=10)
GET {{Franquias.Api_HostAddress}}/api/estoques/1/criticos
Authorization: Bearer {{login.response.body.token}}

###
# 33) Registrar entrada de estoque para viabilizar a venda de teste abaixo
POST {{Franquias.Api_HostAddress}}/api/estoques/movimentacoes
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "unidadeFranqueadaId": 1,
  "produtoServicoId": 1,
  "tipo": 1,
  "quantidade": 20,
  "observacao": "Entrada para teste de venda"
}

###
# 34) Registrar venda (o total e calculado no backend a partir dos itens; da baixa automatica no estoque)
# @name criarVenda
POST {{Franquias.Api_HostAddress}}/api/vendas
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "unidadeFranqueadaId": 1,
  "itens": [
    {
      "produtoServicoId": 1,
      "quantidade": 3
    }
  ]
}

###
# 35) Registrar venda com item sem estoque suficiente (deve retornar 400, sem baixa parcial)
POST {{Franquias.Api_HostAddress}}/api/vendas
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "unidadeFranqueadaId": 1,
  "itens": [
    {
      "produtoServicoId": 1,
      "quantidade": 100000
    }
  ]
}

###
# 36) Registrar venda sem itens (deve retornar 400)
POST {{Franquias.Api_HostAddress}}/api/vendas
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "unidadeFranqueadaId": 1,
  "itens": []
}

###
# 37) Obter venda por id (troque pelo id retornado no passo 34)
GET {{Franquias.Api_HostAddress}}/api/vendas/1
Authorization: Bearer {{login.response.body.token}}

###
# 38) Listar vendas por unidade e intervalo de datas
GET {{Franquias.Api_HostAddress}}/api/vendas?unidadeId=1&dataInicio=2026-01-01&dataFim=2026-12-31&pagina=1&tamanhoPagina=10
Authorization: Bearer {{login.response.body.token}}

###
# 39) Conferir saldo de estoque apos a venda (deve refletir a baixa do passo 34)
GET {{Franquias.Api_HostAddress}}/api/estoques/1/1
Authorization: Bearer {{login.response.body.token}}

###
# 40) Calcular royalty do periodo (soma o faturamento das vendas confirmadas da unidade no mes/ano informado)
# @name calcularRoyalty
POST {{Franquias.Api_HostAddress}}/api/royalties/calcular
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "unidadeFranqueadaId": 1,
  "anoReferencia": 2026,
  "mesReferencia": 9
}

###
# 41) Recalcular o mesmo periodo (deve atualizar o registro existente, nao duplicar)
POST {{Franquias.Api_HostAddress}}/api/royalties/calcular
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "unidadeFranqueadaId": 1,
  "anoReferencia": 2026,
  "mesReferencia": 9
}

###
# 42) Listar royalties por unidade/periodo/status
GET {{Franquias.Api_HostAddress}}/api/royalties?unidadeId=1&anoReferencia=2026&mesReferencia=9
Authorization: Bearer {{login.response.body.token}}

###
# 43) Atualizar status de pagamento do royalty (troque pelo id retornado no passo 40; so Administrador)
PUT {{Franquias.Api_HostAddress}}/api/royalties/1
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "statusPagamento": 2,
  "dataPagamento": "2026-10-05T00:00:00Z"
}

###
# 44) Tentar recalcular um royalty ja marcado como pago (deve retornar 400)
POST {{Franquias.Api_HostAddress}}/api/royalties/calcular
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "unidadeFranqueadaId": 1,
  "anoReferencia": 2026,
  "mesReferencia": 9
}

###
# 45) Abrir chamado de suporte para a unidade
# @name criarChamado
POST {{Franquias.Api_HostAddress}}/api/chamados
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "unidadeFranqueadaId": 1,
  "categoria": "Financeiro",
  "prioridade": 3,
  "descricao": "Divergencia no calculo de royalty do periodo 09/2026."
}

###
# 46) Listar chamados por unidade/status/prioridade
GET {{Franquias.Api_HostAddress}}/api/chamados?unidadeId=1&status=1&pagina=1&tamanhoPagina=10
Authorization: Bearer {{login.response.body.token}}

###
# 47) Consultar chamado por id (troque pelo id retornado no passo 45)
GET {{Franquias.Api_HostAddress}}/api/chamados/1
Authorization: Bearer {{login.response.body.token}}

###
# 48) Atualizar status/prioridade/descricao do chamado (so Administrador; nao aceita status Encerrado aqui)
PUT {{Franquias.Api_HostAddress}}/api/chamados/1
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "status": 2,
  "prioridade": 4
}

###
# 49) Tentar encerrar via PUT (deve retornar 400, use o endpoint de encerramento)
PUT {{Franquias.Api_HostAddress}}/api/chamados/1
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "status": 3
}

###
# 50) Encerrar chamado (so Administrador; registra data de encerramento sem apagar historico)
PATCH {{Franquias.Api_HostAddress}}/api/chamados/1/encerrar
Authorization: Bearer {{login.response.body.token}}

###
# 51) Tentar atualizar um chamado ja encerrado (deve retornar 400)
PUT {{Franquias.Api_HostAddress}}/api/chamados/1
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "prioridade": 1
}

