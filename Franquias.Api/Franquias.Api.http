@Franquias.Api_HostAddress = http://localhost:5192

### Health check
GET {{Franquias.Api_HostAddress}}/api/health
Accept: application/json

###
# 1) Login (troque pelo e-mail/senha de um usuário Administrador já existente no banco)
# @name login
POST {{Franquias.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@franquias.com",
  "senha": "Admin@123"
}

###
# 2) Criar franqueadora (usa o token retornado pelo login acima)
# @name criarFranqueadora
POST {{Franquias.Api_HostAddress}}/api/franqueadora
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "razaoSocial": "Rede Exemplo Ltda",
  "nomeFantasia": "Rede Exemplo",
  "cnpj": "11.222.333/0001-44",
  "email": "contato@rede.com",
  "telefone": "11999990000"
}

###
# 3) Listar franqueadoras
GET {{Franquias.Api_HostAddress}}/api/franqueadora
Authorization: Bearer {{login.response.body.token}}

###
# 4) Criar unidade franqueada (troque franqueadoraId pelo id retornado no passo 2)
# @name criarUnidade
POST {{Franquias.Api_HostAddress}}/api/unidades
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "franqueadoraId": 1,
  "nome": "Unidade Centro",
  "cnpj": "22.333.444/0001-55",
  "telefone": "1133334444",
  "logradouro": "Rua A, 100",
  "cidade": "Sao Paulo",
  "estado": "SP",
  "cep": "01000-000",
  "dataInicio": "2024-01-10",
  "percentualRoyalty": 5.5,
  "responsaveis": [
    {
      "nome": "Joao Silva",
      "cpf": "111.222.333-44",
      "email": "joao@teste.com",
      "telefone": "11988887777",
      "cargo": "Gerente",
      "responsavelPrincipal": true
    }
  ]
}

###
# 5) Listar unidades com filtro + paginação
GET {{Franquias.Api_HostAddress}}/api/unidades?cidade=Paulo&pagina=1&tamanhoPagina=10&ordenarPor=nome
Authorization: Bearer {{login.response.body.token}}

###
# 6) Obter unidade por id (troque pelo id retornado no passo 4)
GET {{Franquias.Api_HostAddress}}/api/unidades/1
Authorization: Bearer {{login.response.body.token}}

###
# 7) Inativar unidade
PATCH {{Franquias.Api_HostAddress}}/api/unidades/1/inativar
Authorization: Bearer {{login.response.body.token}}

###
# 8) Ativar unidade
PATCH {{Franquias.Api_HostAddress}}/api/unidades/1/ativar
Authorization: Bearer {{login.response.body.token}}
